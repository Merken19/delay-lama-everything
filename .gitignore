# Upstream clones. Each is its own git repository (see CLAUDE.md).
/external/

# Packages built by tools/package/make_package.ps1.
/dist/

# Python bytecode.
__pycache__/

# The package's bundled extras (soundfonts, cube maps, songs): large and third-party.
# Only the folder's README and NOTICE are tracked; see bundle/README.md.
/bundle/*
!/bundle/README.md
!/bundle/NOTICE.txt
